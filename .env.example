# SUPABASE CLIENT CONFIGURATION (Required on Netlify -> Site configuration -> Environment variables)
# Do NOT wrap values in quotes in Netlify UI. Never put SUPABASE_SERVICE_ROLE_KEY in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional aliases automatically bridged at build time by vite.config.ts (e.g. Netlify Supabase Integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI Studio Runtime Variables
GEMINI_API_KEY=
APP_URL=

# ---------------------------------------------------------------------------
# SQL SERVER BACKEND (replaces Supabase when set to "sqlserver")
# Both lines are needed: DATA_BACKEND for the Express server, VITE_DATA_BACKEND
# for the browser build. Requires running the app with `npm run dev` / `npm start`
# (the Express server), not as a static Netlify site.
# ---------------------------------------------------------------------------
DATA_BACKEND=
VITE_DATA_BACKEND=

# Option A - Windows authentication / LocalDB (msnodesqlv8 driver, needs "ODBC Driver 17/18 for SQL Server")
# MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=(localdb)\MSSQLLocalDB;Database=PLS;Trusted_Connection=yes;

# Option B - SQL login over TCP (company server; leave MSSQL_CONNECTION_STRING empty)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=PLS
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
